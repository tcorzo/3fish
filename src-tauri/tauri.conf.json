{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3fish",
  "version": "0.1.0",
  "identifier": "com.snoozed.dev.3fish",
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn start",
    "devUrl": "http://localhost:4000",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "decorations": false,
        "fullscreen": false,
        "height": 390,
        "resizable": false,
        "title": "So long...",
        "width": 520,
        "url": "/"
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": "all"
  }
}
